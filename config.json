{
  "products": [
    { "id": "combo", "name": "Combo (multiple products)", "match": "\\s\\+\\s|all hands bundle|booster and \\w+ booster" },
    { "id": "collector-commander-set", "name": "Collector's Edition Commander (set of 4)", "match": "(?=.*collector)(?=.*commander).*(set of 4|all 4|4 decks|complete set|deck bundle)" },
    { "id": "collector-commander", "name": "Collector's Edition Commander Deck", "match": "(?=.*collector)(?=.*commander)" },
    { "id": "commander-set", "name": "Commander Decks (set of 4)", "match": "commander.*(set of 4|all 4|4 decks|complete set|deck bundle)" },
    { "id": "commander", "name": "Commander Deck", "match": "commander" },
    { "id": "draft-night", "name": "Draft Night", "match": "draft night" },
    { "id": "beam-me-up", "name": "Beam Me Up Bundle", "match": "beam me up" },
    { "id": "scene-box-set", "name": "Scene Boxes (set of 2)", "match": "(?=.*scene box)(?=.*set of 2)" },
    { "id": "scene-box", "name": "Scene Box", "match": "scene box" },
    { "id": "beginner-box", "name": "Beginner Box", "match": "beginner" },
    { "id": "prerelease", "name": "Prerelease Pack", "match": "pre-?release" },
    { "id": "play-case", "name": "Play Booster Case (6 boxes)", "match": "play booster case" },
    { "id": "collector-case", "name": "Collector Booster Case", "match": "collector booster case" },
    { "id": "collector-pack", "name": "Collector Booster Pack", "match": "collector.* - (booster )?pack( \\(.*\\))?$|collector'?s? booster( pack)?$" },
    { "id": "play-pack", "name": "Play Booster Pack", "match": "play booster.* - (booster )?pack( \\(.*\\))?$|play booster( pack)?$" },
    { "id": "collector-box", "name": "Collector Booster Box", "match": "collector.*(box|display)" },
    { "id": "play-box", "name": "Play Booster Box", "match": "play.*(box|display)|booster (box|display)" },
    { "id": "bundle", "name": "Bundle", "match": "bundle" }
  ],
  "shops": [
    { "id": "greyogre", "name": "Grey Ogre Games", "type": "shopify", "url": "https://greyogregames.com" },
